{
 "datasets": [
  {
   "name": "ds_mercado",
   "displayName": "mercado",
   "queryLines": [
    "SELECT anio, rendimiento_anual, volatilidad_anual, max_drawdown FROM oracle_prd.gold.kpis_activo_anual WHERE ticker = 'SPY'"
   ]
  },
  {
   "name": "ds_sector",
   "displayName": "sector",
   "queryLines": [
    "SELECT anio, sector, rendimiento_promedio, volatilidad_promedio, peor_drawdown FROM oracle_prd.gold.kpis_sector_anual"
   ]
  },
  {
   "name": "ds_activos",
   "displayName": "activos",
   "queryLines": [
    "SELECT k.anio, k.ticker, c.sector, k.rendimiento_anual, k.volatilidad_anual, k.rendimiento_dividendo FROM oracle_prd.gold.kpis_activo_anual k JOIN oracle_prd.silver.catalogo_activos c USING (ticker) WHERE c.tipo <> 'Indice'"
   ]
  },
  {
   "name": "ds_estrategias_mes",
   "displayName": "estrategias mes",
   "queryLines": [
    "SELECT mes, familia, usd_neto, operaciones FROM oracle_prd.gold.kpis_estrategias"
   ]
  },
  {
   "name": "ds_estrategias_regimen",
   "displayName": "estrategias regimen",
   "queryLines": [
    "SELECT familia, regimen_vix, SUM(operaciones) AS operaciones, ROUND(SUM(ganancia_bruta) / NULLIF(SUM(perdida_bruta), 0), 2) AS profit_factor, ROUND(AVG(tasa_acierto), 3) AS tasa_acierto FROM oracle_prd.gold.kpis_estrategias GROUP BY familia, regimen_vix ORDER BY familia, regimen_vix"
   ]
  },
  {
   "name": "ds_senales",
   "displayName": "senales",
   "queryLines": [
    "SELECT ticker, nombre, sector, fecha, ROUND(cierre, 2) AS cierre, ROUND(rsi2, 1) AS rsi2, senal_e1, senal_e2 FROM oracle_prd.gold.panel_activos WHERE senal_e1 IS NOT NULL OR senal_e2 IS NOT NULL ORDER BY ticker"
   ]
  },
  {
   "name": "ds_calidad",
   "displayName": "calidad",
   "queryLines": [
    "SELECT regla, ROUND(valor, 4) AS valor, umbral, cumple, fecha_utc FROM oracle_prd.control.calidad QUALIFY ROW_NUMBER() OVER (PARTITION BY regla ORDER BY fecha_utc DESC) = 1"
   ]
  }
 ],
